    "format:check": "prettier --check .; prettier --check ../block_editor_frappe/public",
    "format": "prettier --write .; prettier --write ../block_editor_frappe/public"
  },
  "dependencies": {
    "@wordpress/block-editor": "^15.16.0",
    "@wordpress/block-library": "^9.43.0",
    "@wordpress/blocks": "^15.16.0",
    "@wordpress/components": "^32.5.0",
    "@wordpress/format-library": "^5.43.0",
    "react": "^18.3.1",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^9.39.4",
    "@rolldown/plugin-babel": "^0.2.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/wordpress__block-editor": "^15.0.5",
    "@types/wordpress__block-library": "^2.6.3",
    "@types/wordpress__blocks": "^15.10.2",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "sass-embedded": "^1.99.0",
